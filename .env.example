# Copy to .env. Docker Compose reads this file for the Postgres container
# settings, and Prisma CLI commands run from the host read DATABASE_URL.

POSTGRES_USER=budget
POSTGRES_PASSWORD=budget
POSTGRES_DB=budget

# Host ports. Change these if 5432 or 3000 are already taken.
POSTGRES_PORT=5432
WEB_PORT=3000

# Used by the app and the Prisma CLI when running on the host.
# Inside Compose the host name is `db` instead of `localhost`; those services
# get DATABASE_URL injected from compose.yaml and ignore this value.
DATABASE_URL="postgresql://budget:budget@localhost:5432/budget?schema=public"

# Better Auth. Generate a secret with: openssl rand -base64 32
# If you change WEB_PORT, update BETTER_AUTH_URL to match the URL you open in the browser.
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Optional Google OAuth. Leave empty to hide the Google button.
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
